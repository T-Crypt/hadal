# Copy to .env and edit. Docker Compose reads it automatically; Podman Compose too.

# Where the container's port is published on the host.
# Use HADAL_BIND=127.0.0.1 to keep it on this machine only.
HADAL_BIND=0.0.0.0
HADAL_PORT=8787
# lan | cloudflare | tailscale. Keep lan for the published port: the other modes
# listen on the container's own 127.0.0.1, which the host cannot reach.
HADAL_ACCESS=lan

# External folders on the host. Relative paths are relative to docker-compose.yml.
HADAL_DATA=./data
HADAL_EXTENSIONS=./data/extensions
HADAL_THEMES=./data/themes
HADAL_PI_DIR=./data/pi
HADAL_WORKSPACE=./data/workspace

# Chromium flags inside the container. Keep --no-sandbox when running as root.
HADAL_BROWSER_ARGS=--no-sandbox --disable-dev-shm-usage

# Provider keys, if you do not sign in from the app (they are optional):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

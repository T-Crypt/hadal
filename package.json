{
    "name": "hadal",
    "private": true,
    "version": "0.28.2",
    "description": "A self-hosted agent harness, built for local models.",
    "keywords": [
        "pi",
        "ai",
        "agent",
        "coding-agent",
        "mobile",
        "multiplayer",
        "durable"
    ],
    "type": "module",
    "license": "MIT",
    "author": "T-Crypt",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/T-Crypt/hadal.git"
    },
    "homepage": "https://github.com/T-Crypt/hadal",
    "bugs": {
        "url": "https://github.com/T-Crypt/hadal/issues"
    },
    "bin": {
        "hadal": "bin/hadal.js"
    },
    "files": [
        "bin/",
        "src/",
        "web/",
        "types/",
        "docs/",
        "contrib/",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "npm-shrinkwrap.json"
    ],
    "engines": {
        "node": ">=22.19"
    },
    "packageManager": "npm@12.2.0",
    "scripts": {
        "start": "node bin/hadal.js",
        "dev": "node bin/hadal.js --cwd .",
        "check": "tsc --noEmit -p . && node test/types-file.ts && node docs-site/check-reference.mjs",
        "check:web": "node scripts/check-web.mjs",
        "test": "node --test --test-concurrency=4 test/*.test.ts",
        "coverage": "node --test --experimental-test-coverage --test-coverage-lines=60 test/*.test.ts",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint .",
        "prepack": "node -e \"require('node:fs').copyFileSync('package-lock.json', 'npm-shrinkwrap.json')\"",
        "postpack": "node -e \"require('node:fs').rmSync('npm-shrinkwrap.json', { force: true })\"",
        "prepublishOnly": "npm run check && npm run lint && npm test"
    },
    "dependencies": {
        "@earendil-works/chord": "1.5.2",
        "@earendil-works/pi-ai": "1.5.2",
        "@earendil-works/pi-codemode": "1.5.2",
        "@earendil-works/pi-coding-agent": "1.5.2",
        "@earendil-works/pi-durable": "1.5.2",
        "@earendil-works/pi-mcp": "1.5.2",
        "@earendil-works/pi-schema": "1.5.2",
        "dompurify": "^3.4.17",
        "heic-convert": "^2.1.0",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "katex": "^0.19.1",
        "marked": "^18.1.1",
        "minimatch": "10.2.6",
        "pele": "^1.13.0",
        "preact": "^11.0.2",
        "qrcode": "^1.5.4",
        "typebox": "1.3.27",
        "undici": "8.12.3"
    },
    "overrides": {
        "undici": "$undici"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
